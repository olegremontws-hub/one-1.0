# Bath Dream server example
PORT=8787
DB_FILE=server/bathdream.sqlite

# Local development
OTP_ECHO=1

# Production: set NODE_ENV=production, OTP_ECHO=0 and unique long secrets.
OTP_SECRET=replace-with-long-random-secret
SESSION_SECRET=replace-with-another-long-random-secret

# Optional production OTP delivery adapter.
# The server POSTs JSON: requestId, method, contact, code, expiresIn.
OTP_WEBHOOK_URL=
OTP_WEBHOOK_TOKEN=
