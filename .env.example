# Optional full-stack local mode.
# Start the API with: npm run server
# Then start Vite with this variable enabled.
VITE_API_URL=http://localhost:8787


# Yandex Maps address directory + map.
# Create browser keys in Yandex Developer Dashboard.
VITE_YANDEX_MAPS_API_KEY=
VITE_YANDEX_SUGGEST_API_KEY=


# Client messenger external channels.
# Use full URLs for AW HOME accounts/chats. Leave blank until accounts are approved.
VITE_MAX_URL=
VITE_TELEGRAM_URL=
VITE_WHATSAPP_URL=https://wa.me/78003338837
VITE_SUPPORT_EMAIL=info@bath-dream.ru
